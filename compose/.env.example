# Drop this as `.env` next to docker-compose.yml on the host.

# === Required ===
API_KEY=generate-with-openssl-rand-hex-32
GARMIN_EMAIL=
# NOTE: Compose interpolates this file. A literal `$` must be written `$$`,
# or everything from the `$` on is silently replaced with an empty string
# (e.g. `pw$r` reaches the container as `pw`).
GARMIN_PASSWORD=

# === Optional ===
TZ=America/Chicago
APP_PORT=8080
# CORS only matters if a separate-origin client (e.g. another machine's browser direct to /metrics)
# hits this — for the bundled FE this can be left empty since it's same-origin.
CORS_ORIGINS=
GARMIN_BACKFILL_DAYS=90
GARMIN_SCHEDULE_CRON=0 4 * * *

# === Hevy (strength workouts) ===
# Personal API key from https://hevy.com/settings?developer (Hevy Pro only).
# Leave blank to disable Hevy ingestion.
HEVY_API_KEY=

# Bearer secret for /webhooks/hevy. Generate with: openssl rand -hex 32.
# Must match the value passed to Hevy when registering the webhook.
# Leave blank to disable webhook (returns 503).
HEVY_WEBHOOK_SECRET=

# Cron for the cron-poll backstop (every 6h by default).
HEVY_SCHEDULE_CRON=0 */6 * * *

# === USDA FoodData Central (food/barcode fallback) ===
# Free key from https://api.data.gov/signup/. Used to look up US grocery
# products that Open Food Facts doesn't have. Leave blank to disable.
USDA_FDC_API_KEY=

# === Coach (LiteLLM proxy) ===
# All model traffic goes through the proxy rather than straight to a LAN
# Ollama: reachable off-LAN, and the model *alias* pins the sampling params.
# Mint a key with: sherpa litellm_keys generate --name hack-the-body
#
# Use a `-fast` alias. Ollama 0.32 turned thinking ON by default, and a
# thinking model blows past COACH_TIMEOUT_S; the abandoned generation keeps
# running on the GPU, so retries stack until the card is full.
LLM_BASE_URL=https://llm.jc.gravitate.energy/v1
LLM_API_KEY=
LLM_MODEL=ollama/qwen3.6:27b-q4_K_M-fast

# Comma-separated HH:MM local times the coach fires + sends a push.
COACH_SCHEDULE_LOCAL=07:00,12:00,17:00

# Vitamin nag — push fires at this local time if no supplement entry
# has been logged yet today. Leave blank to disable.
VITAMIN_REMINDER_LOCAL=10:00

# === Weekly review (slow, deep) ===
# Sunday at COACH_WEEKLY_LOCAL fires generate_weekly_review. This one uses
# the thinking-enabled (non-`fast`) alias — it runs once a week off-peak,
# takes ~80s, and the extra reasoning buys sharper cross-metric analysis.
WEEKLY_LLM_MODEL=ollama/qwen3.6:35b-a3b-q8_0
WEEKLY_TIMEOUT_S=600
COACH_WEEKLY_LOCAL=21:00

# Web Push (VAPID). Leave keys blank to auto-generate on first start
# (persisted in user_profile collection so they stay stable across restarts).
VAPID_SUBJECT=mailto:hack-the-body@local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Treadmill bridge (ESP8266 CSAFE relay on the LAN) ===
# IP works from inside a docker bridge network (mDNS .local does not).
TREADMILL_BRIDGE_HOST=10.0.6.180
TREADMILL_BRIDGE_PORT=8023
